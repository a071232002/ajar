{
  "name": "ajar",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "e2e": "playwright test",
    "e2e:compose": "podman compose --env-file .env.e2e -f docker-compose.e2e.yml up --build --abort-on-container-exit --exit-code-from e2e",
    "e2e:env": "node scripts/e2e-env.mjs",
    "e2e:compose:docker": "docker compose --env-file .env.e2e -f docker-compose.e2e.yml up --build --abort-on-container-exit --exit-code-from e2e",
    "seed": "node scripts/seed-sample.mjs",
    "audio": "node scripts/generate-audio.mjs",
    "demo": "node scripts/seed-sample.mjs && node scripts/generate-audio.mjs --limit 1"
  },
  "dependencies": {
    "@supabase/ssr": "^0.6.1",
    "@supabase/supabase-js": "^2.47.10",
    "next": "^15.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@breezystack/lamejs": "^1.2.7",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "kokoro-js": "^1.2.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0"
  }
}
