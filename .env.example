# Supabase（本地開發：npx supabase start 後由 `npx supabase status` 取得）
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=<supabase status 的 anon key>
SUPABASE_SERVICE_ROLE_KEY=<supabase status 的 service_role key>

# 生成 API 鑑權（>=32 bytes 隨機值；正式環境與 routine 兩處保持一致）
CRON_SECRET=<openssl rand -hex 32>
